{
	"compilerOptions": {
		"target": "ES2023",
		"lib": [
			"ES2023"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"sourceMap": true,
		"strict": true,
		"outDir": "out",
		"rootDir": "src",
          "allowJs": true,
          "composite": true,
          "types": ["node"]
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}