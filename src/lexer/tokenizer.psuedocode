
function tokenize(input):
    tokens = []
    i = 0

    while i < length(input):
        char = input[i]

        if char is whitespace:
            i += 1
            continue

        if char starts a number:
            start = i
            while next char is digit or dot:
                i += 1
            tokens.append({ type: "NUMBER", text: input[start:i] })
            continue

        if char is letter or underscore:
            start = i
            while next char is letter, digit, or underscore:
                i += 1
            text = input[start:i]
            if text is in keyword list:
                tokens.append({ type: "KEYWORD", text })
            else:
                tokens.append({ type: "IDENTIFIER", text })
            continue

        if char is quote:
            quoteChar = char
            i += 1
            start = i
            while i < length(input) and input[i] != quoteChar:
                i += 1
            text = input[start:i]
            i += 1  // consume closing quote
            tokens.append({ type: "STRING", text })
            continue

        if char is one of punctuation/operators:
            tokens.append({ type: "SYMBOL", text: char })
            i += 1
            continue

        // handle unknown / error
        raise error("Unexpected character: " + char)

    return tokens